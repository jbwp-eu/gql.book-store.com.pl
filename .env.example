# Local backend env — copy to `.env` and fill secrets.
# Production on VPS: see `.env.production.example` (or paste from `.env` and adjust).

ADMIN_PASSWORD=change-me
PORT=4000
# Generate with: openssl rand -hex 32
# Do not commit the real value. Copy this file to `.env` and replace the placeholder
# (the app will refuse to start if JWT_SECRET is missing, short, or this example string).
JWT_SECRET=change-me-long-random

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
CONTACT_RECIPIENT=

GOOGLE_MAPS_API_KEY_geocoding=
STORE_ADDRESS=Rondo Dmowskiego 10, 00-590 Warszawa, Poland

IMAGE_DIR=uploads

# ovh = gql.book-store.com.pl | aws = gql.book-store.pl
DEPLOY_TARGET=ovh
STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_AWS=
# Stripe Dashboard → Webhooks → Signing secret for each endpoint (not Stripe CLI)
# OVH: https://gql.book-store.com.pl/webhooks/stripe
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
# AWS: https://gql.book-store.pl/webhooks/stripe
STRIPE_WEBHOOK_SECRET_TEST_MODE_AWS=
# Local: stripe listen --forward-to localhost:4000/webhooks/stripe
# (whsec_… from CLI output — temporary, only while listen is running)
STRIPE_WEBHOOK_SECRET_TEST_MODE_CLI=
CURRENCY=PLN

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

FRONTEND_ORIGIN=http://localhost:5173

# --- Optional when using local `npm start` / mirroring production ---
# NODE_ENV=production
# DB_PATH=./data/store.db
# TRUST_PROXY=1
# IMAGE_BASE_URL=http://localhost:4000/images
# ORDER_CONFIRMATION_QUEUE_URL=
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
