# EC2 AWS (v2) production env template.
# Prefer the root [`.env.production.example`](../.env.production.example) as the source of truth.
# Copy to `/var/www/gql-book-store/shared/.env.production` (or paste from local `.env` and adjust).

NODE_ENV=production
PORT=4000
DB_PATH=/var/www/gql-book-store/shared/data/store.db
IMAGE_DIR=/var/www/gql-book-store/shared/uploads
TRUST_PROXY=1
FRONTEND_ORIGIN=https://gql.book-store.pl
IMAGE_BASE_URL=https://gql.book-store.pl/images

ADMIN_PASSWORD=change-me
# Generate with: openssl rand -hex 32 — do not leave this placeholder on the VPS.
JWT_SECRET=change-me-long-random

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
CONTACT_RECIPIENT=

# Order confirmation emails (SQS → Lambda). Leave empty to disable enqueue.
ORDER_CONFIRMATION_QUEUE_URL=
AWS_REGION=eu-central-1
# Prefer EC2 instance IAM role. Access keys only if you must (not recommended on EC2).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

GOOGLE_MAPS_API_KEY_geocoding=
STORE_ADDRESS=

# ovh = gql.book-store.com.pl | aws = gql.book-store.pl
DEPLOY_TARGET=aws
STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_AWS=
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
STRIPE_WEBHOOK_SECRET_TEST_MODE_AWS=
CURRENCY=PLN

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
