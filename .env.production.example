# Template for VPS / production: copy to
#   /var/www/gql-book-store/shared/.env.production
# (or start from your local `.env` and change the values marked below).
#
# Local development uses only `.env` in the repo root (see `.env.example` if present).
# Backend load order (NODE_ENV=production): `.env.production` if present, else `.env`.

NODE_ENV=production
PORT=4000

# Paths on the server (not localhost relative paths)
DB_PATH=/var/www/gql-book-store/shared/data/store.db
IMAGE_DIR=/var/www/gql-book-store/shared/uploads
TRUST_PROXY=1

# ovh = gql.book-store.com.pl | aws = gql.book-store.pl
DEPLOY_TARGET=aws
FRONTEND_ORIGIN=https://gql.book-store.pl
IMAGE_BASE_URL=https://gql.book-store.pl/images
# OVH example:
# DEPLOY_TARGET=ovh
# FRONTEND_ORIGIN=https://gql.book-store.com.pl
# IMAGE_BASE_URL=https://gql.book-store.com.pl/images

ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
CONTACT_RECIPIENT=

GOOGLE_MAPS_API_KEY_geocoding=
STORE_ADDRESS=Rondo Dmowskiego 10, 00-590 Warszawa, Poland

# Stripe — set both pairs; active pair follows DEPLOY_TARGET
STRIPE_SECRET_KEY_TEST_MODE_OVH=
STRIPE_SECRET_KEY_TEST_MODE_AWS=
# Dashboard → Webhooks → Signing secret (not Stripe CLI)
# OVH: https://gql.book-store.com.pl/webhooks/stripe
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=
# AWS: https://gql.book-store.pl/webhooks/stripe
STRIPE_WEBHOOK_SECRET_TEST_MODE_AWS=
CURRENCY=PLN

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional — order confirmation email (SQS → Lambda). Leave empty to disable.
ORDER_CONFIRMATION_QUEUE_URL=
AWS_REGION=eu-central-1
# Required on OVH (no EC2 instance role). On EC2 leave empty and use IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
